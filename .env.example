# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/oms_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_db_password

# Security & JWT
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_hex
JWT_EXPIRATION_MS=86400000

# Initial Admin Account (First Boot Seeding)
SEED_DATA_ENABLED=true
INITIAL_ADMIN_EMAIL=admin@oms.com
INITIAL_ADMIN_PASSWORD=Admin@123
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_PHONE=+919876543210

# Payment Gateway (Optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY=inr
